# Copy to .env (never commit .env)

# --- Running the backend directly (npm run dev / npm start) ---
PORT=4000
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/edushare
# Or MongoDB Atlas (keep the real password out of Git):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/edushare

# --- Running with Docker Compose ---
# Not used. Compose reads the root .env file (see ../.env.example) and builds
# MONGODB_URI itself, pointing at the "mongo" service instead of 127.0.0.1.
