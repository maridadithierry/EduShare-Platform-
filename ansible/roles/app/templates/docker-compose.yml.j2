# Managed by Ansible (roles/app)
# Production version of the repo's docker-compose.yml: the app image is
# pulled from Docker Hub instead of being built on the server.
services:
  app:
    image: "{{ app_image }}:{{ app_image_tag }}"
    restart: unless-stopped
    env_file: .env
    ports:
      - "{{ app_public_port }}:{{ app_container_port }}"
    depends_on:
      mongo:
        condition: service_healthy
    networks:
      - edushare
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:{{ app_container_port }}{{ app_health_path }} || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s

  mongo:
    image: "{{ mongo_image }}"
    restart: unless-stopped
    env_file: .env
    # No ports published: MongoDB is reachable only from the app container
    volumes:
      - mongo-data:/data/db
    networks:
      - edushare
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping')"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s

volumes:
  mongo-data:

networks:
  edushare:
