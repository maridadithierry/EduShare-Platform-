# Dependencies: reinstalled inside the image
**/node_modules


# Build output: produced inside the image
**/dist
**/build
coverage


# Secrets and local environment files: never bake into an image
.env
**/.env
.env.*
**/.env.*


# Version control and CI
.git
.gitignore
.github


# Logs
*.log
npm-debug.log*


# Editor and OS files
.vscode
.idea
.DS_Store


# Tests and lint config are not needed at runtime
backend/tests
backend/eslint.config.js


# Docker files themselves and docs are not needed at runtime
Dockerfile
docker-compose.yml
.dockerignore
*.md